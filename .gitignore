# --- Rust ---
target/
# Cargo's build profile directory, anchored. Unanchored it also swallowed
# configs/debug/, which is committed configuration rather than build output.
/debug/
**/*.rs.bk
*.pdb
**/mutants.out*/

# --- Python (training and dataset tooling) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Coverage ---
coverage/
.coverage
lcov.info
*.profraw
*.profdata

# --- Models and datasets (referenced, never committed) ---
*.onnx
*.pt
*.pth
datasets/
models/

# --- IDE and editors ---
.vs/
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Secrets and local env ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json

# --- Local overrides ---
*.local.yml

# --- MuJoCo ---
MUJOCO_LOG.TXT

# --- Misc ---
*.log
tmp/
temp/
.cache/

# --- Training runs (checkpoints, never committed) ---
runs/

# --- Scene assets, converted from a pinned submodule and a pinned download ---
# Generated by scripts/import_scene_assets.py. Derived from bytes that are
# already pinned, so committing them would put a second copy in the history
# that no digest describes.
#
# Anchored to the repository root on purpose. Unanchored, this pattern matches
# any directory named `assets` at any depth, which silently swallowed the
# vendored manipulator's own mesh directory and left a clone unable to build the
# world at all. A rule about one generated directory must not reach into
# third_party/.
/assets/

# Object meshes fetched by scripts/import_scene_assets.py --objects.
# The commits and digests live in configs/assets/objects.yml. The full
# collections are not submodules.
/third_party/scanned_objects/
/third_party/ycb_sim/
