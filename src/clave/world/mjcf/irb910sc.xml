<!--
  A SCARA manipulator in the geometry of the ABB IRB 910SC-3/0.65.

  CLAVE owns this model. No open MJCF or URDF of an industrial SCARA exists:
  neither DeepMind's MuJoCo Menagerie nor the robot_descriptions collection
  carries one, and the ROBOTIS menagerie pinned in third_party/ holds only
  serial arms. The one community SCARA on GitHub is a generic educational model
  whose reach is not stated. So rather than adopt an unverifiable model, the
  kinematics here are built from ABB's published product specification and every
  number is traceable to it. docs/measurements.md tabulates the source.

  What is faithful: link lengths, joint ranges, joint speeds, the Z stroke, the
  base footprint and the column height. Those are what decide whether a pick is
  reachable, which is the only thing this simulation asks of the arm.

  What is not: the link shapes are capsules and boxes rather than the cast
  housings ABB ships. Appearance does not enter any measurement CLAVE takes, and
  a primitive collides faster and more predictably than a scanned hull.

  Mounting is inverted. The base attaches at the top and the arm hangs into the
  workspace, matching ABB's own IRB 910INV variant. docs/architecture.md carries
  the comparison against a floor pedestal and why this won.
-->
<mujoco model="irb910sc_3_065">
  <compiler angle="radian" autolimits="true"/>

  <default>
    <default class="scara">
      <joint frictionloss="0.1" armature="0.1" damping="1.0"/>
      <position kp="2000" dampratio="1"/>
      <geom type="capsule" density="700" rgba="0.87 0.85 0.80 1"/>

      <!-- Axis 1: shoulder rotation, +/-140 deg, 415 deg/s. -->
      <default class="axis1">
        <joint type="hinge" axis="0 0 1" range="-2.443461 2.443461"/>
        <position forcerange="-300 300"/>
      </default>
      <!-- Axis 2: elbow rotation, +/-150 deg, 659 deg/s. -->
      <default class="axis2">
        <joint type="hinge" axis="0 0 1" range="-2.617994 2.617994"/>
        <position forcerange="-200 200"/>
      </default>
      <!-- Axis 3: spline up and down, 180 mm stroke, 1.02 m/s, 250 N down force.
           Inverted mounting points it downward, so travel runs 0 to -0.180. -->
      <default class="axis3">
        <joint type="slide" axis="0 0 1" range="-0.180 0.0"/>
        <position forcerange="-250 250" kp="8000"/>
      </default>
      <!-- Axis 4: spline rotation, +/-400 deg, 2400 deg/s. This is the axis an
           OpenMANIPULATOR-X does not have, and the reason a SCARA can align a
           jaw or a cup to an object's minor axis. -->
      <default class="axis4">
        <joint type="hinge" axis="0 0 1" range="-6.981317 6.981317"/>
        <position forcerange="-40 40" kp="200"/>
      </default>
    </default>
  </default>

  <worldbody>
    <body name="scara_base" childclass="scara">
      <!-- Base housing: 160 x 160 mm footprint, hanging from its mount. -->
      <geom name="scara_mount" type="box" size="0.080 0.080 0.030"
            pos="0 0 0.030" rgba="0.35 0.35 0.38 1"/>
      <!-- Column. The published overall height is 620 mm; the portion below the
           mounting face that carries axis 1 is 251 mm. -->
      <geom name="scara_column" type="cylinder" size="0.065 0.1255"
            pos="0 0 -0.1255"/>

      <body name="scara_arm1" pos="0 0 -0.251">
        <joint name="Joint1" class="axis1"/>
        <!-- Arm 1 spans 400 mm from axis 1 to axis 2 on the 0.65 m variant.
             ABB ships 200 mm on the 0.45 and 300 mm on the 0.55. -->
        <geom name="scara_arm1_link" fromto="0 0 0  0.400 0 0" size="0.045"/>

        <body name="scara_arm2" pos="0.400 0 -0.060">
          <joint name="Joint2" class="axis2"/>
          <!-- Arm 2 spans 250 mm on every variant. -->
          <geom name="scara_arm2_link" fromto="0 0 0  0.250 0 0" size="0.038"/>

          <body name="scara_spline" pos="0.250 0 0">
            <joint name="Joint3" class="axis3"/>
            <joint name="Joint4" class="axis4"/>
            <!-- The ball screw spline, 20 mm shaft. Drawn over the full stroke
                 so a retracted tool is visible above the work surface. -->
            <geom name="scara_spline_shaft" type="cylinder" size="0.010 0.115"
                  pos="0 0 -0.115" rgba="0.55 0.55 0.58 1"/>

            <!-- Tool flange. An end effector attaches here; the site is what
                 clave.world.arm reads as the tool point. -->
            <body name="scara_flange" pos="0 0 -0.230">
              <geom name="scara_flange_plate" type="cylinder" size="0.022 0.008"
                    rgba="0.35 0.35 0.38 1"/>
              <site name="tool_point" pos="0 0 -0.008" size="0.006"
                    rgba="0.9 0.2 0.2 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!--
    Adjacent links touch at every joint by construction: arm 1 starts at the
    shoulder, which is where the column ends. MuJoCo's automatic parent-child
    filtering does not survive attaching this spec into a larger scene, so the
    pairs are excluded here rather than left to it. Without these the arm drives
    into its own column and stalls, which looks exactly like a reach failure and
    is not one.
  -->
  <contact>
    <exclude body1="scara_base" body2="scara_arm1"/>
    <exclude body1="scara_arm1" body2="scara_arm2"/>
    <exclude body1="scara_arm2" body2="scara_spline"/>
    <exclude body1="scara_spline" body2="scara_flange"/>
    <exclude body1="scara_base" body2="scara_arm2"/>
  </contact>

  <actuator>
    <position class="axis1" name="Joint1" joint="Joint1" inheritrange="1"/>
    <position class="axis2" name="Joint2" joint="Joint2" inheritrange="1"/>
    <position class="axis3" name="Joint3" joint="Joint3" inheritrange="1"/>
    <position class="axis4" name="Joint4" joint="Joint4" inheritrange="1"/>
  </actuator>
</mujoco>
